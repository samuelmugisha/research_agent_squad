# Copy this file to .env and fill in your values. Never commit .env.

# --- Models (OpenRouter recommended: one key for chat, embeddings and web search)
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Or use OpenAI directly (remove OPENAI_BASE_URL) and Tavily for web search:
# TAVILY_API_KEY=tvly-...
SEARCH_MAX_RESULTS=5

# --- First Principal Investigator account (created when there are no accounts yet)
ADMIN_USERNAME=you@lab.org
ADMIN_NAME=Your Name
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=research-agent-squad

# --- Optional: Hugging Face deployment (see deploy_space.py)
# HF_BACKUP_TOKEN=hf_...   fine-grained token with write access to the backup dataset
